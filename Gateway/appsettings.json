{
  "ReverseProxy": {
    "Routes": {
      "tasks": {
        "ClusterId": "calendar",
        "Match": { "Path": "/api/tasks/{**catch-all}" }
      },
      "tags": {
        "ClusterId": "calendar",
        "Match": { "Path": "/api/tags/{**catch-all}" }
      },
      "stats": {
        "ClusterId": "analytics",
        "Match": { "Path": "/api/stats/{**catch-all}" }
      }
    },
    "Clusters": {
      "calendar": {
        "Destinations": {
          "main": { "Address": "http://localhost:5101/" }
        }
      },
      "analytics": {
        "Destinations": {
          "main": { "Address": "http://localhost:5102/" }
        }
      }
    }
  }
}
